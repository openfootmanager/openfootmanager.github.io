---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../../layouts/BlogPost.astro";
import { languages, defaultLang, type Lang } from "../../../i18n/ui";
import { getBaseSlug } from "../../../i18n/utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const locales = Object.keys(languages).filter(
    (l) => l !== defaultLang,
  ) as Lang[];

  return locales.flatMap((lang) =>
    posts
      .filter((post) => (post.data.lang ?? "en") === lang)
      .map((post) => ({
        params: { lang, slug: getBaseSlug(post.id) },
        props: { post, lang },
      })),
  );
}

const { post, lang } = Astro.props as {
  post: CollectionEntry<"blog">;
  lang: Lang;
};
const { Content } = await render(post);
---

<BlogPost {...post.data} lang={lang}>
  <Content />
</BlogPost>

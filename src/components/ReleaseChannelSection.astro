---
import { Icon } from "astro-icon/components";
import DownloadChecksums from "./DownloadChecksums.astro";
import DownloadSplitButton from "./DownloadSplitButton";
import type { DownloadOption } from "../data/downloads";
import type { Lang } from "../i18n/ui";
import { formatReleaseDate, useTranslations } from "../i18n/utils";
import { formatBytes, getAssetDisplayLabel } from "../lib/release";
import type { ReleaseAsset, ReleaseManifest } from "../types/release";

interface ReleaseNotice {
    title: string;
    text: string;
    items: string[];
}

interface Props {
    lang: Lang;
    release: ReleaseManifest;
    title: string;
    subtitle?: string;
    badge?: string;
    badgeTone?: "emerald" | "amber";
    notice?: ReleaseNotice;
    checksumsTitle?: string;
}

const {
    lang,
    release,
    title,
    subtitle,
    badge,
    badgeTone = "emerald",
    notice,
    checksumsTitle,
} = Astro.props;

const t = useTranslations(lang);
const releaseDate = new Date(release.publishedAt);

const windowsDownloads = getDownloadsForPlatform("windows");
const macosDownloads = getDownloadsForPlatform("macos");
const linuxDownloads = getDownloadsForPlatform("linux");

const badgeClasses =
    badgeTone === "amber"
        ? "text-amber-700 bg-amber-500/10 dark:text-amber-300 dark:bg-amber-900/30"
        : "text-emerald-400 bg-emerald-500/10 dark:bg-emerald-900/30";

const iconMonitor =
    '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>';
const iconLaptop =
    '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/></svg>';
const iconTerminal =
    '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>';

function getDownloadsForPlatform(platform: string): DownloadOption[] {
    return release.assets
        .filter((asset) => asset.platform.trim().toLowerCase() === platform)
        .map(mapReleaseAssetToDownloadOption);
}

function mapReleaseAssetToDownloadOption(asset: ReleaseAsset): DownloadOption {
    return {
        label: getAssetDisplayLabel(asset),
        arch: asset.arch,
        url: asset.downloadUrl,
        size: formatBytes(asset.size),
        sha256: asset.sha256,
        filename: asset.name,
    };
}
---

<div class="space-y-8">
    <div>
        <div class="flex flex-wrap items-center gap-3 mb-2">
            <h2
                class="font-heading text-3xl font-bold uppercase text-slate-900 dark:text-white"
            >
                {title}
            </h2>
            {
                badge && (
                    <span
                        class:list={[
                            "inline-block px-3 py-1 text-sm font-heading font-bold rounded-full",
                            badgeClasses,
                        ]}
                    >
                        {badge}
                    </span>
                )
            }
        </div>
        {
            subtitle && (
                <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-6 max-w-2xl">
                    {subtitle}
                </p>
            )
        }
        <div class="flex flex-wrap items-center gap-3 mb-8">
            <span
                class="inline-block px-3 py-1 text-sm font-heading font-bold text-emerald-400 bg-emerald-500/10 dark:bg-emerald-900/30 rounded-full"
            >
                {release.tag}
            </span>
            {
                release.prerelease && (
                    <span class="inline-block px-3 py-1 text-sm font-heading font-bold text-amber-600 bg-amber-500/10 dark:bg-amber-900/30 rounded-full">
                        PRERELEASE
                    </span>
                )
            }
            <span class="text-sm text-slate-500 dark:text-slate-400"
                >{formatReleaseDate(releaseDate, lang)}</span
            >
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            {
                windowsDownloads.length > 0 && (
                    <DownloadSplitButton
                        client:load
                        label={t("download.button.windows")}
                        iconSvg={iconMonitor}
                        options={windowsDownloads}
                    />
                )
            }
            {
                macosDownloads.length > 0 && (
                    <DownloadSplitButton
                        client:load
                        label={t("download.button.macos")}
                        iconSvg={iconLaptop}
                        options={macosDownloads}
                    />
                )
            }
            {
                linuxDownloads.length > 0 && (
                    <DownloadSplitButton
                        client:load
                        label={t("download.button.linux")}
                        iconSvg={iconTerminal}
                        options={linuxDownloads}
                    />
                )
            }
        </div>

        <div class="text-center">
            <a
                href={release.releaseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm text-emerald-600 dark:text-emerald-400 hover:text-emerald-500 transition-colors font-heading font-semibold uppercase tracking-wider"
            >
                <Icon name="lucide:github" class="w-4 h-4" />
                {t("download.button.allreleases")}
            </a>
        </div>
    </div>

    {
        notice && (
            <div class="rounded-2xl border-2 border-amber-400/50 bg-amber-50 dark:bg-amber-950/20 p-6 md:p-8">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 w-10 h-10 rounded-full bg-amber-400/20 flex items-center justify-center">
                        <Icon
                            name="lucide:triangle-alert"
                            class="w-5 h-5 text-amber-500"
                        />
                    </div>
                    <div>
                        <h3 class="font-heading text-xl font-bold uppercase text-amber-700 dark:text-amber-400 mb-3">
                            {notice.title}
                        </h3>
                        <p
                            class="text-slate-700 dark:text-slate-300 leading-relaxed mb-4"
                            set:html={notice.text}
                        />
                        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
                            {notice.items.map((item) => (
                                <li class="flex items-start gap-2">
                                    <Icon
                                        name="lucide:alert-circle"
                                        class="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0"
                                    />
                                    <span set:html={item} />
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>
        )
    }

    <DownloadChecksums
        assets={release.assets}
        lang={lang}
        title={checksumsTitle}
    />
</div>

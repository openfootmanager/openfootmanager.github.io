---
import { Icon } from "astro-icon/components";

interface Props {
  src: string;
  alt: string;
  openLabel: string;
  closeLabel: string;
  variant?: "primary" | "secondary";
}

const {
  src,
  alt,
  openLabel,
  closeLabel,
  variant = "secondary",
} = Astro.props;

const isPrimary = variant === "primary";
---

<div data-screenshot-lightbox>
  <button
    type="button"
    class:list={[
      "group relative block w-full cursor-zoom-in overflow-hidden border border-slate-200 bg-slate-950 text-left transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-4 focus-visible:ring-offset-white dark:border-slate-800 dark:focus-visible:ring-offset-slate-950",
      isPrimary
        ? "aspect-[16/10] rounded-[2rem] shadow-2xl shadow-slate-950/10"
        : "aspect-[16/10] rounded-[1.5rem] shadow-lg shadow-slate-950/10",
    ]}
    aria-label={`${openLabel}: ${alt}`}
    data-screenshot-trigger
  >
    <img
      src={src}
      alt={alt}
      loading="lazy"
      class:list={[
        "h-full w-full object-cover transition-transform duration-500",
        isPrimary ? "group-hover:scale-[1.015]" : "group-hover:scale-[1.02]",
      ]}
    />
    <div
      class:list={[
        "pointer-events-none absolute z-10 inline-flex items-center justify-center rounded-full border border-white/15 bg-slate-950/70 p-3 text-white opacity-0 backdrop-blur transition-all duration-300 group-hover:opacity-100 group-focus-visible:opacity-100",
        isPrimary ? "right-5 top-5" : "right-4 top-4",
      ]}
    >
      <Icon name="lucide:search" class="h-4 w-4" />
    </div>
    <div
      class:list={[
        "absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/95 via-slate-950/40 to-transparent",
        isPrimary ? "p-5" : "p-4",
      ]}
    >
      <span class="inline-flex rounded-full border border-white/15 bg-slate-950/70 px-3 py-1 text-[11px] font-heading font-bold uppercase tracking-[0.18em] text-white backdrop-blur">
        {alt}
      </span>
    </div>
  </button>

  <dialog
    class="screenshot-dialog m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 text-white"
    aria-label={alt}
    data-screenshot-dialog
  >
    <div class="relative flex min-h-full items-center justify-center p-4 sm:p-8">
      <button
        type="button"
        class="absolute right-4 top-4 z-20 inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-slate-950/80 text-white backdrop-blur transition-colors hover:bg-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
        aria-label={`${closeLabel}: ${alt}`}
        data-screenshot-close
      >
        <Icon name="lucide:x" class="h-5 w-5" />
      </button>

      <div class="flex max-w-[min(96vw,1600px)] cursor-auto flex-col items-center gap-4">
        <img
          src={src}
          alt={alt}
          loading="lazy"
          class:list={[
            "max-h-[82vh] w-auto max-w-full border border-white/10 object-contain shadow-2xl shadow-black/60",
            isPrimary ? "rounded-[1.75rem]" : "rounded-[1.5rem]",
          ]}
        />
        <p class="rounded-full border border-white/10 bg-slate-950/70 px-4 py-2 text-sm font-semibold text-slate-100 backdrop-blur">
          {alt}
        </p>
      </div>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll("[data-screenshot-lightbox]").forEach((lightbox) => {
    if (!(lightbox instanceof HTMLElement) || lightbox.dataset.bound === "true") {
      return;
    }

    const trigger = lightbox.querySelector("[data-screenshot-trigger]");
    const dialog = lightbox.querySelector("[data-screenshot-dialog]");
    const closeButton = lightbox.querySelector("[data-screenshot-close]");

    if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement)) {
      return;
    }

    lightbox.dataset.bound = "true";

    const openDialog = () => {
      if (dialog.open) {
        return;
      }

      document.documentElement.classList.add("overflow-hidden");
      dialog.showModal();
    };

    const closeDialog = () => {
      if (!dialog.open) {
        return;
      }

      dialog.close();
    };

    trigger.addEventListener("click", openDialog);
    closeButton?.addEventListener("click", closeDialog);

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        closeDialog();
      }
    });

    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("overflow-hidden");
    });
  });
</script>

<style is:inline>
  .screenshot-dialog {
    border: none;
  }

  .screenshot-dialog::backdrop {
    background: rgba(2, 6, 23, 0.86);
    backdrop-filter: blur(14px);
  }
</style>
---
import { Icon } from "astro-icon/components";
import ReleaseChannelSection from "./ReleaseChannelSection.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { getOptionalReleaseManifest, getReleaseManifest } from "../lib/release";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const stableRelease = await getReleaseManifest();
const nightlyRelease = await getOptionalReleaseManifest("nightly");
const stablePrereleaseNotice = t("download.alpha.text").replace(
  /v0\.1\.0-alpha/g,
  stableRelease.tag,
);

const stableNotice = stableRelease.prerelease
  ? {
      title: t("download.alpha.title"),
      text: stablePrereleaseNotice,
      items: [
        t("download.alpha.list.bugs"),
        t("download.alpha.list.saves"),
        t("download.alpha.list.features"),
        t("download.alpha.list.feedback"),
      ],
    }
  : undefined;

const nightlyNotice = nightlyRelease
  ? {
      title: t("download.nightly.notice.title"),
      text: t("download.nightly.notice.text"),
      items: [
        t("download.nightly.notice.list.unstable"),
        t("download.nightly.notice.list.compatibility"),
        t("download.nightly.notice.list.feedback"),
      ],
    }
  : undefined;

const requirements = [
  {
    label: t("download.requirements.os"),
    value: t("download.requirements.os.value"),
  },
  {
    label: t("download.requirements.ram"),
    value: t("download.requirements.ram.value"),
  },
  {
    label: t("download.requirements.disk"),
    value: t("download.requirements.disk.value"),
  },
  {
    label: t("download.requirements.display"),
    value: t("download.requirements.display.value"),
  },
];
---

<section
  class="relative pt-32 pb-4 bg-gradient-to-b from-emerald-950 to-slate-950"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <span
        class="inline-block px-4 py-1.5 text-xs font-heading font-bold uppercase tracking-widest text-emerald-400 bg-emerald-900/30 rounded-full mb-4"
      >
        {t("download.badge")}
      </span>
      <h1
        class="font-heading text-4xl md:text-6xl font-bold uppercase text-white mb-6"
      >
        {t("download.heading.line1")}<br /><span class="text-amber-400"
          >{t("download.heading.line2")}</span
        >
      </h1>
      <p class="text-lg text-emerald-100/70 leading-relaxed max-w-2xl">
        {t("download.subtitle")}
      </p>
    </div>
  </div>
</section>

<section class="py-20 bg-white dark:bg-slate-950">
  <div class="container-narrow">
    <div class="max-w-3xl mx-auto space-y-16">
      <ReleaseChannelSection
        lang={lang}
        release={stableRelease}
        title={t("download.version")}
        badge={t("download.channel.stable")}
        badgeTone="emerald"
        notice={stableNotice}
      />

      {
        nightlyRelease && (
          <ReleaseChannelSection
            lang={lang}
            release={nightlyRelease}
            title={t("download.nightly.title")}
            subtitle={t("download.nightly.description")}
            badge={t("download.channel.nightly")}
            badgeTone="amber"
            notice={nightlyNotice}
            checksumsTitle={t("download.nightly.checksums.title")}
          />
        )
      }

      <div>
        <h2
          class="font-heading text-3xl font-bold uppercase text-slate-900 dark:text-white mb-6"
        >
          {t("download.requirements.title")}
        </h2>
        <div
          class="rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden"
        >
          {
            requirements.map((req, i) => (
              <div
                class:list={[
                  "flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-0 p-4",
                  i !== requirements.length - 1 &&
                    "border-b border-slate-200 dark:border-slate-800",
                ]}
              >
                <div class="sm:w-1/3 font-heading font-bold text-sm uppercase tracking-wider text-slate-900 dark:text-white">
                  {req.label}
                </div>
                <div class="sm:w-2/3 text-sm text-slate-600 dark:text-slate-400">
                  {req.value}
                </div>
              </div>
            ))
          }
        </div>
        <p
          class="mt-4 text-sm text-slate-500 dark:text-slate-500 leading-relaxed"
        >
          {t("download.requirements.note")}
        </p>
      </div>

      <div>
        <h2
          class="font-heading text-3xl font-bold uppercase text-slate-900 dark:text-white mb-6"
        >
          {t("download.instructions.title")}
        </h2>
        <div
          class="space-y-4 text-slate-700 dark:text-slate-300 leading-relaxed"
        >
          <div
            class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800"
          >
            <Icon
              name="lucide:monitor"
              class="w-5 h-5 text-emerald-500 mt-0.5 flex-shrink-0"
            />
            <p class="text-sm" set:html={t("download.instructions.windows")} />
          </div>
          <div
            class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800"
          >
            <Icon
              name="lucide:laptop"
              class="w-5 h-5 text-emerald-500 mt-0.5 flex-shrink-0"
            />
            <p class="text-sm" set:html={t("download.instructions.macos")} />
          </div>
          <div
            class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800"
          >
            <Icon
              name="lucide:terminal"
              class="w-5 h-5 text-emerald-500 mt-0.5 flex-shrink-0"
            />
            <p class="text-sm" set:html={t("download.instructions.linux")} />
          </div>
        </div>
      </div>

      <div
        class="rounded-2xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 p-6 md:p-8 text-center"
      >
        <Icon
          name="lucide:bug"
          class="w-10 h-10 text-emerald-500 mx-auto mb-4"
        />
        <h2
          class="font-heading text-2xl font-bold uppercase text-slate-900 dark:text-white mb-3"
        >
          {t("download.community.title")}
        </h2>
        <p class="text-slate-600 dark:text-slate-400 mb-6 max-w-lg mx-auto">
          {t("download.community.text")}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="https://github.com/openfootmanager/openfootmanager/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-white font-heading font-bold uppercase tracking-wider rounded-xl transition-all duration-200 shadow-lg shadow-emerald-500/25"
          >
            <Icon name="lucide:github" class="w-5 h-5" />
            {t("download.community.button")}
          </a>
          <a
            href="https://discord.gg/2CXaesaukT"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 border-2 border-slate-300 hover:border-indigo-400 dark:border-slate-700 dark:hover:border-indigo-400 text-slate-900 dark:text-white font-heading font-bold uppercase tracking-wider rounded-xl transition-all duration-200"
          >
            <Icon name="lucide:messages-square" class="w-5 h-5 text-indigo-500" />
            Discord
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

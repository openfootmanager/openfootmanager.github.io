---
import BaseLayout from "./BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { type Lang, defaultLang } from "../i18n/ui";
import { useTranslations, getLocalePath, getDateLocale } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  image?: string;
  lang?: Lang;
}

const lang = Astro.props.lang ?? defaultLang;
const t = useTranslations(lang);
const dateLocale = getDateLocale(lang);
const openImageLabel = t("features.page.zoom");
const closeImageLabel = t("features.page.close");

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = "Openfoot Manager Team",
  tags = [],
  image,
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString(dateLocale, {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString(dateLocale, {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={`${title} — Openfoot Manager Blog`}
  description={description}
  image={image}
  lang={lang}
>
  <article
    class="pt-32 pb-24"
    data-blog-post-root
    data-blog-open-label={openImageLabel}
  >
    <div class="container-narrow">
      <!-- Back link -->
      <a
        href={getLocalePath(lang, "/blog")}
        class="inline-flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors mb-8"
      >
        <Icon name="lucide:chevron-left" class="h-4 w-4" />
        {t("blog.back")}
      </a>

      <!-- Header -->
      <header class="mb-12">
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-4">
              {tags.map((tag) => (
                <span class="px-3 py-1 text-xs font-semibold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
          )
        }

        <h1
          class="font-heading text-4xl md:text-5xl font-bold uppercase text-slate-900 dark:text-white mb-4"
        >
          {title}
        </h1>

        <div
          class="flex flex-wrap items-center gap-4 text-sm text-slate-500 dark:text-slate-400"
        >
          <span>{t("blog.by")} {author}</span>
          <span>·</span>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {
            formattedUpdatedDate && (
              <>
                <span>·</span>
                <span>
                  {t("blog.updated")} {formattedUpdatedDate}
                </span>
              </>
            )
          }
        </div>
      </header>

      {
        image && (
          <img
            src={image}
            alt={title}
            width="1200"
            height="630"
            fetchpriority="high"
            class="w-full h-64 md:h-96 object-cover rounded-2xl mb-12"
          />
        )
      }

      <!-- Content -->
      <div class="prose-blog" data-blog-content>
        <slot />
      </div>

      <dialog
        class="blog-image-dialog m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 text-white"
        aria-label={closeImageLabel}
        data-blog-image-dialog
      >
        <div
          class="relative flex min-h-full items-center justify-center p-4 sm:p-8"
        >
          <button
            type="button"
            class="absolute right-4 top-4 z-20 inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-slate-950/80 text-white backdrop-blur transition-colors hover:bg-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
            aria-label={closeImageLabel}
            data-blog-image-close
          >
            <Icon name="lucide:x" class="h-5 w-5" />
          </button>

          <figure
            class="flex max-w-[min(96vw,1600px)] cursor-auto flex-col items-center gap-4"
          >
            <img
              src=""
              alt=""
              loading="lazy"
              class="max-h-[82vh] w-auto max-w-full rounded-[1.5rem] border border-white/10 object-contain shadow-2xl shadow-black/60"
              data-blog-image-preview
            />
            <figcaption
              class="hidden rounded-full border border-white/10 bg-slate-950/70 px-4 py-2 text-sm font-semibold text-slate-100 backdrop-blur"
              data-blog-image-caption
            >
            </figcaption>
          </figure>
        </div>
      </dialog>
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll("[data-blog-post-root]").forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.zoomBound === "true") {
      return;
    }

    const dialog = root.querySelector("[data-blog-image-dialog]");
    const previewImage = root.querySelector("[data-blog-image-preview]");
    const caption = root.querySelector("[data-blog-image-caption]");
    const closeButton = root.querySelector("[data-blog-image-close]");
    const openLabel = root.dataset.blogOpenLabel ?? "Zoom image";

    if (
      !(dialog instanceof HTMLDialogElement) ||
      !(previewImage instanceof HTMLImageElement) ||
      !(caption instanceof HTMLElement)
    ) {
      return;
    }

    root.dataset.zoomBound = "true";

    const closeDialog = () => {
      if (!dialog.open) {
        return;
      }

      dialog.close();
    };

    const openDialog = (image: HTMLImageElement) => {
      const source = image.currentSrc || image.src;

      if (!source) {
        return;
      }

      const altText = image.alt.trim();

      previewImage.src = source;
      previewImage.alt = altText;
      caption.textContent = altText;
      caption.classList.toggle("hidden", altText.length === 0);

      if (dialog.open) {
        return;
      }

      document.documentElement.classList.add("overflow-hidden");
      dialog.showModal();
    };

    root.querySelectorAll("[data-blog-content] img").forEach((image) => {
      if (!(image instanceof HTMLImageElement) || image.closest("a")) {
        return;
      }

      image.classList.add("blog-zoomable-image");

      if (!image.hasAttribute("tabindex")) {
        image.tabIndex = 0;
      }

      image.setAttribute("role", "button");

      const altText = image.alt.trim();
      image.setAttribute(
        "aria-label",
        altText.length > 0 ? `${openLabel}: ${altText}` : openLabel,
      );

      image.addEventListener("click", () => openDialog(image));
      image.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") {
          return;
        }

        event.preventDefault();
        openDialog(image);
      });
    });

    closeButton?.addEventListener("click", closeDialog);

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        closeDialog();
      }
    });

    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("overflow-hidden");
    });
  });
</script>

<style is:inline>
  .blog-zoomable-image {
    cursor: zoom-in;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .blog-zoomable-image:hover,
  .blog-zoomable-image:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 24px 40px -24px rgba(15, 23, 42, 0.5);
    outline: none;
  }

  .blog-image-dialog {
    border: none;
  }

  .blog-image-dialog::backdrop {
    background: rgba(2, 6, 23, 0.86);
    backdrop-filter: blur(14px);
  }
</style>
